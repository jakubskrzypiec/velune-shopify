<section class="product-details wrap"><div class="details-intro"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="prose">{{ section.settings.description }}</div></div><div class="detail-moments">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="moment-number">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><div class="prose">{{ block.settings.copy }}</div></article>{% endfor %}</div><div class="design-note"><p class="eyebrow">PROSTY DETAL. CIEPŁY DOM.</p><p>Brązowe szkło, kremowa etykieta i delikatna ilustracja. Jesienny akcent, który nie musi znikać wraz z końcem sezonu.</p></div></section>
{% schema %}
{"name":"Zapach w Twoim rytmie","settings":[{"type":"text","id":"kicker","label":"Nadtytuł","default":"MAŁE RYTUAŁY"},{"type":"text","id":"heading","label":"Nagłówek","default":"Niech ten wieczór będzie Twój."},{"type":"richtext","id":"description","label":"Opis","default":"<p>Nie potrzebujesz wielkich planów. Wystarczy przestrzeń, w której dobrze Ci być, i mała chwila dla siebie.</p>"}],"blocks":[{"type":"moment","name":"Domowy moment","settings":[{"type":"text","id":"title","label":"Tytuł","default":"Wieczór z książką"},{"type":"richtext","id":"copy","label":"Opis","default":"<p>Ulubiony fotel, miękki koc i jeszcze jeden rozdział.</p>"}]}],"presets":[{"name":"Zapach w Twoim rytmie"}]}
{% endschema %}