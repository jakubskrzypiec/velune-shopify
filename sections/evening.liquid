<section id="marka" class="evening"><div id="rytual" class="evening-copy"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="prose">{{ section.settings.description }}</div><a class="button button-dark" href="{{ routes.all_products_collection_url }}">{{ section.settings.cta | escape }} <span aria-hidden="true">↗</span></a></div><div class="evening-image">{% assign play = section.settings.motion %}{% if section.settings.image != blank %}{% assign play = false %}{% endif %}{% render 'living-scene', image: section.settings.image, fallback: 'velune-apple-crumble-evening-v1.webp', alt: 'Otwarta świeca Apple Crumble i herbata przy jesiennym oknie', fx: 50.2, fy: 46.2, tea: true, tx: 79.6, ty: 53.5, curtain: true, animate: play %}</div></section>
{% schema %}
{"name":"Idealny wieczór","settings":[{"type":"text","id":"kicker","label":"Nadtytuł","default":"CHWILA TYLKO DLA CIEBIE"},{"type":"text","id":"heading","label":"Nagłówek","default":"Idealny wieczór? Już jesteś w domu."},{"type":"richtext","id":"description","label":"Opis","default":"<p>Za oknem jesień. W kubku ciepła herbata. Obok delikatny blask świecy i zapach, do którego chce się wracać.</p><p>Otul swój wieczór. Reszta może poczekać.</p>"},{"type":"text","id":"cta","label":"Przycisk","default":"Znajdź swój zapach"},{"type":"image_picker","id":"image","label":"Zdjęcie"},{"type":"checkbox","id":"motion","label":"Subtelne animacje zdjęcia podglądu","default":true}],"presets":[{"name":"Idealny wieczór"}]}
{% endschema %}