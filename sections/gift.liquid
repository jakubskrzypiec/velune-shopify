<section class="gift-section wrap"><div class="gift-photo">{% render 'picture', image: section.settings.image, fallback: 'velune-gift-autumn-v2.webp', alt: 'Świeca Velune w ciepłej jesiennej aranżacji z liśćmi i wstążką', sizes: '(min-width: 900px) 40vw, 100vw' %}</div><div class="gift-copy"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="prose">{{ section.settings.description }}</div><div class="gift-reasons"><span>Mały gest. Dużo ciepła.</span><span>Trzy jesienne inspiracje.</span><span>Prosty detal do przytulnego domu.</span></div><a class="button button-dark" href="{{ routes.all_products_collection_url }}">{{ section.settings.cta | escape }} <span aria-hidden="true">↗</span></a></div></section>
{% schema %}
{"name":"Pomysł na prezent","settings":[{"type":"text","id":"kicker","label":"Nadtytuł","default":"DLA KOGOŚ BLISKIEGO"},{"type":"text","id":"heading","label":"Nagłówek","default":"Podaruj komuś idealny wieczór."},{"type":"richtext","id":"description","label":"Opis","default":"<p>Czasem najpiękniejszy prezent to zaproszenie do odpoczynku. Ulubiony zapach, ciepły kubek i chwila tylko dla siebie.</p><p>Wybierz jesienną inspirację dla przyjaciółki, mamy albo kogoś, kto lubi małe domowe rytuały.</p>"},{"type":"text","id":"cta","label":"Przycisk","default":"Wybierz zapach na prezent"},{"type":"image_picker","id":"image","label":"Zdjęcie"}],"presets":[{"name":"Pomysł na prezent"}]}
{% endschema %}