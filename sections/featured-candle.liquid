<section class="featured wrap"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Zobacz produkty <span aria-hidden="true">↗</span></a></div><div class="featured-grid">{% render 'product-card', product: section.settings.product %}<div class="featured-editorial">{% render 'picture', image: section.settings.image, fallback: 'velune-autumn-hero.webp', alt: 'Jesienny rytuał z Velune', sizes: '(min-width: 900px) 60vw, 100vw' %}<div><p class="eyebrow light">{{ section.settings.story_kicker | escape }}</p><h3>{{ section.settings.story_heading | escape }}</h3></div></div></div></section>
{% schema %}
{
  "name": "Świeca wyróżniona",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Nadtytuł",
      "default": "PIERWSZY ROZDZIAŁ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Jesień zamknięta w zapachu."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Wyróżniony produkt"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Zdjęcie atmosfery"
    },
    {
      "type": "text",
      "id": "story_kicker",
      "label": "Nadtytuł zdjęcia",
      "default": "APPLE CRUMBLE"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Tekst zdjęcia",
      "default": "Jak powrót do domu."
    }
  ],
  "presets": [
    {
      "name": "Świeca wyróżniona"
    }
  ]
}
{% endschema %}
