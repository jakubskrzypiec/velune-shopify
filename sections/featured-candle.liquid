<section class="featured wrap"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Zobacz produkty <span aria-hidden="true">↗</span></a></div><div class="collection-grid">{% if section.settings.collection != blank %}{% for item in section.settings.collection.products limit: 3 %}{% render 'product-card', product: item %}{% else %}{% render 'preview-candles' %}{% endfor %}{% else %}{% render 'preview-candles' %}{% endif %}</div></section>
{% schema %}
{
  "name": "Jesienna kolekcja",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Nadtytuł",
      "default": "PIERWSZY ROZDZIAŁ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Jesień zamknięta w zapachu."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kolekcja produktów"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Zdjęcie atmosfery"
    },
    {
      "type": "text",
      "id": "story_kicker",
      "label": "Nadtytuł zdjęcia",
      "default": "APPLE CRUMBLE"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Tekst zdjęcia",
      "default": "Jak powrót do domu."
    }
  ],
  "presets": [
    {
      "name": "Świeca wyróżniona"
    }
  ]
}
{% endschema %}
