{% assign candle_handle = product.handle | default: 'apple-crumble' %}
{% assign candle_image = 'velune-' | append: candle_handle | append: '-front-v3.webp' %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_title = product.title | default: section.settings.fallback_title %}
<section class="product wrap" data-product-section>
<nav class="breadcrumbs" aria-label="Ścieżka strony"><a href="{{ routes.root_url }}">Velune</a><span aria-hidden="true">/</span><a href="{{ routes.all_products_collection_url }}">Świece</a><span aria-hidden="true">/</span><span>{{ product_title | escape }}</span></nav>
<div class="product-grid"><div class="gallery"><div class="gallery-main">{% render 'picture', image: product.featured_image, fallback: candle_image, alt: product_title, class: 'gallery-active', width: 1233, height: 1275, loading: 'eager', sizes: '(min-width: 900px) 50vw, 100vw' %}</div><div class="gallery-thumbs" aria-label="Ujęcia produktu">{% render 'product-gallery-thumbs', product: product, candle_handle: candle_handle, product_title: product_title %}</div><p class="gallery-current" data-gallery-caption aria-live="polite">Przód</p></div>
<div class="product-info product-info--focused"><h1>{{ product_title | escape }}</h1><h2 class="buy-heading">{{ section.settings.sales_heading | escape }}</h2><div class="buy-copy">{% if product.description != blank %}{{ product.description }}{% else %}<p>{{ section.settings.sales_copy | escape }}</p>{% endif %}</div><div class="product-facts"><div><strong>{{ section.settings.weight | escape }}</strong><span>wosku sojowego</span></div><div><strong>{{ section.settings.volume | escape }}</strong><span>brązowego szkła</span></div><div><strong>{{ section.settings.burn_time | escape }}</strong><span>palenia wg producenta</span></div></div>
{% if settings.preview_mode or product == blank %}<div class="purchase-preview">{% render 'product-offer' %}{% render 'scent-selector', candle_handle: candle_handle %}{% render 'product-bundles', section: section %}<button class="button button-dark purchase-button" disabled>Wybieram ten zapach · premiera wkrótce</button></div>{% else %}{% render 'scent-selector', candle_handle: candle_handle %}<p class="product-price">{{ current_variant.price | money }}</p>{% form 'product', product, id: 'ProductForm' %}<label class="variant-label" for="Variant-{{ section.id }}">Wariant</label><select name="id" id="Variant-{{ section.id }}" class="variant-select">{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — niedostępny{% endunless %}</option>{% endfor %}</select><label class="variant-label" for="Quantity-{{ section.id }}">Liczba sztuk</label><input class="quantity" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1"><button class="button button-dark purchase-button" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Dodaj do koszyka{% else %}Niedostępne{% endif %}</button>{% endform %}{% endif %}
<a class="product-story-link text-link" href="#zapach">Wejdź w ten zapach <span aria-hidden="true">↓</span></a>
<div class="product-accordions">{% for block in section.blocks %}{% if block.type == 'accordion' %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}<span aria-hidden="true">+</span></summary><div class="prose">{{ block.settings.content }}</div></details>{% endif %}{% endfor %}</div></div></div>
{% if settings.preview_mode or product == blank %}<div class="mobile-product-bar"><div><strong>{{ product_title | escape }}</strong><span>{{ settings.preview_price | default: 50 | times: 100 | money }} · cena premierowa</span></div><button disabled>Wkrótce</button></div>{% else %}<div class="mobile-product-bar"><div><strong>{{ product_title | escape }}</strong><span>{{ current_variant.price | money }}</span></div><a href="#ProductForm">Wybierz wariant ↑</a></div>{% endif %}
</section>
{% schema %}
{
  "name": "Karta świecy",
  "settings": [
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Tytuł podglądu",
      "default": "Apple Crumble"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Nadtytuł",
      "default": "VELUNE / ŚWIECA ZAPACHOWA"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Podtytuł",
      "default": "Twój ulubiony deser. Teraz jako domowy rytuał."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Opis podglądu",
      "default": "<p>Wyobraź sobie jabłka prosto z piekarnika, złotą kruszonkę i wieczór, który nigdzie się nie spieszy.</p><p>Apple Crumble czerpie inspirację z zapachu przytulnego domu. Słodki, ciepły, inspirowany małymi przyjemnościami jesieni.</p>"
    },
    {
      "type": "text",
      "id": "weight",
      "label": "Masa wosku",
      "default": "150 g"
    },
    {
      "type": "text",
      "id": "volume",
      "label": "Pojemność",
      "default": "180 ml"
    },
    {
      "type": "text",
      "id": "burn_time",
      "label": "Czas palenia",
      "default": "ok. 35 h"
    },
    {
      "type": "text",
      "id": "image_tag",
      "label": "Etykieta zdjęcia",
      "default": "JESIEŃ W SŁOIKU"
    },
    {
      "type": "text",
      "id": "launch_note",
      "label": "Status premiery",
      "default": "Ten zapach jest w przygotowaniu."
    },
    {
      "type": "text",
      "id": "launch_detail",
      "label": "Informacja",
      "default": "Planowana cena premierowa: 50 zł. Termin dostępności podamy przed premierą."
    },
    {
      "type": "text",
      "id": "sales_heading",
      "label": "Hasło główne",
      "default": "Zamień zwykły wieczór w swoją ulubioną chwilę."
    },
    {
      "type": "textarea",
      "id": "sales_copy",
      "label": "Krótki opis oferty",
      "default": "Inspiracja pieczonymi jabłkami i złotą kruszonką. Ciepły, domowy klimat na wieczór z książką, kocem i chwilą tylko dla siebie."
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Skojarzenie zapachu",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Skojarzenie",
          "default": "Pieczone jabłka"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Informacje rozwijane",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tytuł",
          "default": "O świecy"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Treść",
          "default": "<p>Wosk sojowy, bawełniany knot i brązowy słoik. Szczegóły finalnej kompozycji podamy przed premierą.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
