<section class="hero hero--collection">
{% render 'picture', image: section.settings.image, fallback: 'velune-collection-hero-v2.webp', alt: 'Trzy świece Velune z kremowymi etykietami w jesiennej aranżacji', class: 'hero-image', loading: 'eager' %}
<div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p class="hero-description">{{ section.settings.description | escape }}</p><a class="button button-dark" href="{% if section.settings.product != blank %}{{ section.settings.product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.cta | escape }} <span aria-hidden="true">↗</span></a></div><span class="hero-footnote">DOM PACHNIE DOBRZE.</span>
</section>
{% schema %}
{
  "name": "Jesienny hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Ilustracja hero"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Nadtytuł",
      "default": "VELUNE / JESIENNE RYTUAŁY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Jesień ma\nswój zapach."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Opis",
      "default": "Trzy zapachy inspirowane jesienią. Małe rytuały, które sprawiają, że chce się zostać w domu."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Przycisk",
      "default": "Poznaj kolekcję"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt główny"
    }
  ],
  "presets": [
    {
      "name": "Jesienny hero"
    }
  ]
}
{% endschema %}
