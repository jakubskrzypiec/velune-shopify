<section class="hero">
{% render 'picture', image: section.settings.image, fallback: 'velune-autumn-hero.webp', alt: 'Świeca Velune Apple Crumble w ciepłym jesiennym wnętrzu', class: 'hero-image', loading: 'eager' %}
<div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow light">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p class="hero-description">{{ section.settings.description | escape }}</p><a class="button button-cream" href="{% if section.settings.product != blank %}{{ section.settings.product.url }}{% else %}/products/apple-crumble{% endif %}">{{ section.settings.cta | escape }} <span aria-hidden="true">↗</span></a></div><span class="hero-footnote">DOM PACHNIE DOBRZE.</span>
</section>
{% schema %}
{
  "name": "Jesienny hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Zdjęcie główne"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Nadtytuł",
      "default": "VELUNE / JESIENNE RYTUAŁY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Nagłówek",
      "default": "Zostań.\nJeszcze chwilę."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Opis",
      "default": "Zapach pieczonych jabłek. Ciepło domowego wieczoru. Małe przyjemności, do których chce się wracać."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Przycisk",
      "default": "Poznaj Apple Crumble"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt główny"
    }
  ],
  "presets": [
    {
      "name": "Jesienny hero"
    }
  ]
}
{% endschema %}
