<section class="autumn-interlude" aria-label="Jesienny park"><div class="park-image">{% render 'picture', image: section.settings.image, fallback: 'velune-park-photo-v1.webp', alt: 'Złote drzewa i ścieżka w jesiennym parku' %}</div><div class="park-shade"></div>{% if section.settings.motion %}<div class="falling-leaves" aria-hidden="true">{% for i in (1..24) %}<span class="falling-leaf" style="--i:{{ i }}"><svg viewBox="0 0 48 54" focusable="false"><path d="M24 0 29 13 41 8 37 23 48 27 34 34 35 45 25 42 24 54 22 42 12 46 13 35 0 27 11 22 6 9 19 14Z" fill="currentColor"/><path d="M24 8 24 46M24 29 12 22M24 35 35 28" stroke="#5f321b" stroke-width="1" fill="none"/></svg></span>{% endfor %}</div>{% endif %}<div class="park-copy"><p class="eyebrow light">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="button button-cream" href="{{ routes.all_products_collection_url }}">Poznaj jesienne zapachy ↗</a></div></section>
{% schema %}
{"name":"Jesienny park","settings":[{"type":"text","id":"kicker","label":"Nadtytuł","default":"JESIEŃ, KTÓRĄ CHCESZ ZATRZYMAĆ"},{"type":"text","id":"heading","label":"Nagłówek","default":"Przynieś ten nastrój do domu."},{"type":"text","id":"description","label":"Opis","default":"Złote liście, chłodne powietrze i ciepły powrót. Wybierz zapach na swój wieczór."},{"type":"image_picker","id":"image","label":"Zdjęcie parku"},{"type":"checkbox","id":"motion","label":"Opadające liście","default":true}],"presets":[{"name":"Jesienny park"}]}
{% endschema %}