<section class="faq-section wrap"><div class="faq-heading"><p class="eyebrow">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="text-link" href="/pages/kontakt">Kontakt z Velune ↗</a></div><div class="faq-list">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="prose">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}
{"name":"Pytania i odpowiedzi","settings":[{"type":"text","id":"kicker","label":"Nadtytuł","default":"WARTO WIEDZIEĆ"},{"type":"text","id":"heading","label":"Nagłówek","default":"Masz jeszcze pytanie?"},{"type":"text","id":"description","label":"Wprowadzenie","default":"Kilka odpowiedzi, zanim wybierzesz swój jesienny zapach."}],"blocks":[{"type":"question","name":"Pytanie","settings":[{"type":"text","id":"question","label":"Pytanie","default":"Co kryje słoik Velune?"},{"type":"richtext","id":"answer","label":"Odpowiedź","default":"<p>Wosk sojowy, bawełniany knot i brązowy słoik. Szczegóły finalnej kompozycji podamy przed premierą.</p>"}]}],"presets":[{"name":"Pytania i odpowiedzi","blocks":[{"type":"question"}]}]}
{% endschema %}