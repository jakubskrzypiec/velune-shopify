{% if image != blank %}<img class="{{ class }}" src="{{ image | image_url: width: 1600 }}" srcset="{{ image | image_url: width: 480 }} 480w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w" sizes="{{ sizes | default: '100vw' }}" alt="{{ alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="{{ loading | default: 'lazy' }}"{% if loading == 'eager' %} fetchpriority="high"{% endif %}>{% else %}<img class="{{ class }}" src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" width="{{ width | default: 1536 }}" height="{{ height | default: 1024 }}" loading="{{ loading | default: 'lazy' }}"{% if loading == 'eager' %} fetchpriority="high"{% endif %}>{% endif %}