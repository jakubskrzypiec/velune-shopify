{% assign candle_handle = product.handle | default: card_handle | default: 'apple-crumble' %}
{% assign candle_image = 'velune-' | append: candle_handle | append: '-minimal.webp' %}
{% assign fallback_url = '/products/' | append: candle_handle %}
{% assign card_url = product.url | default: fallback_url %}{% assign card_alt = product.title | default: card_title | default: 'Apple Crumble' %}
<article class="product-card"><a class="card-image" href="{{ card_url }}">{% render 'picture', image: product.featured_image, fallback: candle_image, alt: card_alt, width: 1233, height: 1275, sizes: '(min-width: 900px) 33vw, 100vw' %}{% if settings.preview_mode %}<span class="card-badge">Wkrótce</span>{% endif %}<span class="card-arrow" aria-hidden="true">↗</span></a><div class="card-meta"><div><p class="eyebrow">ŚWIECA ZAPACHOWA</p><h3><a href="{{ card_url }}">{{ product.title | default: card_title | default: 'Apple Crumble' | escape }}</a></h3></div>{% unless settings.preview_mode %}{% if product != blank %}<span>{{ product.price | money }}</span>{% endif %}{% endunless %}</div><p class="card-description">{% if product.metafields.custom.short_description != blank %}{{ product.metafields.custom.short_description.value | escape }}{% else %}{{ card_copy | default: 'Jesienny zapach w przygotowaniu.' | escape }}{% endif %}</p></article>