{% assign card_url = product.url | default: '/products/apple-crumble' %}{% assign card_alt = product.title | default: 'Velune Apple Crumble — wizualizacja świecy' %}
<article class="product-card"><a class="card-image" href="{{ card_url }}">{% render 'picture', image: product.featured_image, fallback: 'velune-apple-crumble.webp', alt: card_alt, width: 1233, height: 1275, sizes: '(min-width: 900px) 33vw, 100vw' %}{% if settings.preview_mode %}<span class="card-badge">Wkrótce</span>{% endif %}<span class="card-arrow" aria-hidden="true">↗</span></a><div class="card-meta"><div><p class="eyebrow">ŚWIECA ZAPACHOWA</p><h3><a href="{{ card_url }}">{{ product.title | default: 'Apple Crumble' | escape }}</a></h3></div>{% unless settings.preview_mode %}{% if product != blank %}<span>{{ product.price | money }}</span>{% endif %}{% endunless %}</div><p class="card-description">{% if product.metafields.custom.short_description != blank %}{{ product.metafields.custom.short_description.value | escape }}{% else %}Pieczone jabłka. Złota kruszonka. Domowy wieczór.{% endif %}</p></article>