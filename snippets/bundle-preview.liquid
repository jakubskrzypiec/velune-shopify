{% assign base_price = settings.preview_price | default: 50 | times: 100 %}{% assign duo = base_price | times: 2 | times: 95 | divided_by: 100 %}{% assign trio = base_price | times: 3 | times: 90 | divided_by: 100 %}
<fieldset class="bundle-picker" data-bundle-picker><legend>Więcej przytulnych wieczorów</legend><label class="bundle-choice"><input type="radio" name="bundle-{{ section.id }}" value="1" data-total="{{ base_price | money }}" checked><span><strong>Jedna świeca</strong><small>Na Twój pierwszy rytuał</small></span><b>{{ base_price | money }}</b></label><label class="bundle-choice"><input type="radio" name="bundle-{{ section.id }}" value="2" data-total="{{ duo | money }}"><span><strong>Dwie świece <em>−5%</em></strong><small>Ten sam zapach · {{ base_price | times: 95 | divided_by: 100 | money }} / szt.</small></span><b>{{ duo | money }}</b></label><label class="bundle-choice"><input type="radio" name="bundle-{{ section.id }}" value="3" data-total="{{ trio | money }}"><span><strong>Trzy świece <em>−10%</em></strong><small>Ten sam zapach · {{ base_price | times: 90 | divided_by: 100 | money }} / szt.</small></span><b>{{ trio | money }}</b></label><p class="bundle-total">Razem: <strong data-bundle-total aria-live="polite">{{ base_price | money }}</strong></p><p class="price-context">Planowane pakiety. Zakup będzie dostępny po premierze.</p></fieldset>