{% assign price = settings.preview_price | default: 50 | times: 100 %}{% assign regular = settings.preview_regular_price | default: 75 | times: 100 %}{% assign saving = regular | minus: price %}<div class="product-offer"><div class="offer-top"><span>Planowana oferta premierowa</span>{% if saving > 0 %}<b>−{{ saving | times: 100 | divided_by: regular | floor }}%</b>{% endif %}</div><div class="offer-price"><strong>{{ price | money }}</strong>{% if saving > 0 %}<s aria-label="Planowana cena regularna">{{ regular | money }}</s>{% endif %}</div></div>