{% assign scent_handles = 'apple-crumble|cinnamon|pumpkin-spice-latte' | split: '|' %}{% assign scent_names = 'Apple Crumble|Cinnamon|Pumpkin Spice Latte' | split: '|' %}<nav class="scent-selector" aria-label="Wybierz zapach"><p>Wybierz zapach</p><div>{% for scent_handle in scent_handles %}{% assign scent_product = all_products[scent_handle] %}{% assign scent_fallback = '/products/' | append: scent_handle %}<a class="scent-choice{% if candle_handle == scent_handle %} is-selected{% endif %}" href="{{ scent_product.url | default: scent_fallback }}"{% if candle_handle == scent_handle %} aria-current="page"{% endif %}><span class="scent-dot scent-dot--{{ scent_handle }}" aria-hidden="true"></span><strong>{{ scent_names[forloop.index0] }}</strong>{% if candle_handle == scent_handle %}<span class="scent-check" aria-hidden="true">✓</span>{% endif %}</a>{% endfor %}</div></nav>