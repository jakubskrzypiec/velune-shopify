{% if product.images.size > 0 %}{% for img in product.images %}<button class="gallery-thumb{% if forloop.first %} is-active{% endif %}" data-image="{{ img | image_url: width: 1600 }}" data-alt="{{ img.alt | default: product_title | escape }}" data-label="{{ img.alt | default: 'Zdjęcie produktu' | escape }}" aria-label="Pokaż zdjęcie {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ img | image_url: width: 200 }}" alt="" width="200" height="200" loading="lazy"><span>{{ img.alt | default: 'Zdjęcie' | truncate: 24 | escape }}</span></button>{% endfor %}{% else %}{% assign gallery_labels = 'Przód|Otwarta świeca|Tył słoika|W pokoju|Etykieta|Inspiracja zapachu' | split: '|' %}{% for i in (0..5) %}{% case i %}{% when 0 %}{% assign file = 'velune-' | append: candle_handle | append: '-front-v3.webp' %}{% when 1 %}{% assign file = 'velune-' | append: candle_handle | append: '-open-v1.webp' %}{% when 2 %}{% assign file = 'velune-candle-back-v1.webp' %}{% when 3 %}{% assign file = 'velune-' | append: candle_handle | append: '-evening-v1.webp' %}{% when 4 %}{% assign file = 'velune-' | append: candle_handle | append: '-label-minimal.webp' %}{% when 5 %}{% assign file = 'velune-' | append: candle_handle | append: '-scent-v1.webp' %}{% endcase %}<button class="gallery-thumb{% if i == 0 %} is-active{% endif %}" data-image="{{ file | asset_url }}" data-alt="{{ product_title | escape }} — {{ gallery_labels[i] | escape }}" data-label="{{ gallery_labels[i] | escape }}" data-fit="{% if i == 3 or i == 4 %}contain{% else %}cover{% endif %}" aria-label="Pokaż: {{ gallery_labels[i] | escape }}" aria-pressed="{% if i == 0 %}true{% else %}false{% endif %}"><img src="{{ file | asset_url }}" alt="" width="200" height="200" loading="lazy"><span>{{ gallery_labels[i] }}</span></button>{% endfor %}{% endif %}