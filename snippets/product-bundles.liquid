{% assign base = settings.preview_price | default: 50 | times: 100 %}{% assign duo = base | times: 2 | times: 95 | divided_by: 100 %}{% assign trio = base | times: 3 | times: 90 | divided_by: 100 %}<fieldset class="bundle-picker compact-bundles" data-bundle-picker><legend>Wybierz swój pakiet</legend><div class="bundle-options"><label class="bundle-choice"><input type="radio" name="bundle-{{ section.id }}" value="1" data-total="{{ base | money }}" checked><span><strong>1 świeca</strong><b>{{ base | money }}</b></span></label><label class="bundle-choice"><input type="radio" name="bundle-{{ section.id }}" value="2" data-total="{{ duo | money }}"><span><strong>2 świece <em>−5%</em></strong><b>{{ duo | money }}</b></span></label><label class="bundle-choice"><input type="radio" name="bundle-{{ section.id }}" value="3" data-total="{{ trio | money }}"><span><strong>3 świece <em>−10%</em></strong><b>{{ trio | money }}</b></span></label></div><p class="bundle-total">Razem <strong data-bundle-total aria-live="polite">{{ base | money }}</strong></p></fieldset>